# Cloudflare Worker URL for reminder agent.
# Copy this file to .env.local and fill in your deployed Worker URL.
# .env.local is gitignored (*.local pattern) so secrets stay out of the repo.
VITE_WORKER_URL=https://foreman-reminders.<your-subdomain>.workers.dev

# Note: the Groq API key (AI features) and Gmail OAuth Client ID/Secret (Gmail Bill
# Import) are NOT configured here. Foreman is a public repo — a VITE_-prefixed env
# var gets inlined verbatim into the shipped JS bundle, which would leak a
# maintainer's personal key to anyone who opens devtools on a distributed build.
# Each user enters their own keys at runtime instead, in Preferences → Integrations.
